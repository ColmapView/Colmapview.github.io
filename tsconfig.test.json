{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* Vitest runs the tests in node with jsdom, so they see node and DOM globals. */
    "types": ["vite/client", "node"]
  },
  /* Check tests, helpers and imported modules. Override the app exclusions
     explicitly so extending that project does not silently omit the tests. */
  "include": ["src"],
  "exclude": []
}
